# ─────────────────────────────────────────────────────────
# Mridha Villa 2 — Environment Variables
# Copy to .env.local for local dev, set in Vercel for prod
# ─────────────────────────────────────────────────────────

# MongoDB Atlas
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mridha-villa-2?retryWrites=true&w=majority"

# NextAuth — generate: openssl rand -base64 32
AUTH_SECRET="your-secret-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Cloudinary (for uploads)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Vercel Cron — any long random string; Vercel sends it to /api/cron/charges
CRON_SECRET="generate: openssl rand -base64 32"

NODE_ENV="development"
